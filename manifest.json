{
  "manifest_version": 3,
  "name": "Dreaming Tools",
  "version": "0.10.2",
  "description": "Companion tools for Dreaming: video difficulty ratings and series ranges, plus subtitle de-emphasis for listen-only practice.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://app.dreaming.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.dreaming.com/spanish/*",
        "https://app.dreaming.com/french/*"
      ],
      "js": [
        "src/settings.js",
        "src/difficulty-core.js",
        "src/difficulty.js",
        "src/subtitles-core.js",
        "src/subtitles.js",
        "src/content.js"
      ],
      "css": [
        "src/difficulty.css",
        "src/subtitles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "all_frames": true,
      "js": [
        "src/settings.js",
        "src/subtitles-core.js",
        "src/subtitles.js",
        "src/content.js"
      ],
      "css": [
        "src/subtitles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
