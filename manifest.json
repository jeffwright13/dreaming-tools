{
  "manifest_version": 3,
  "name": "Dreaming Difficulty",
  "version": "0.4.0",
  "description": "Adds video difficulty ratings and series difficulty ranges across Dreaming.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.dreaming.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.dreaming.com/spanish/*",
        "https://app.dreaming.com/french/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
