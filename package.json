{
  "name": "dreaming-tools",
  "version": "1.0.0",
  "description": "Chrome extension with small tools for Dreaming, starting with video and series difficulty ratings.",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package": "node scripts/package-extension.js",
    "package:verify": "node scripts/package-extension.js --verify",
    "test:live": "npm run package && playwright test",
    "test:live:login": "npm run package && node tests/live/login.js",
    "store:screenshots": "node scripts/store-screenshots.js"
  },
  "keywords": [
    "chrome-extension",
    "dreaming-languages"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.12"
  }
}
